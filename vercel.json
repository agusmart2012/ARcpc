{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?route=/api/$1" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{public,lib}/**",
      "maxDuration": 15
    },
    "api/[...path].js": {
      "includeFiles": "{public,lib}/**",
      "maxDuration": 15
    }
  }
}
